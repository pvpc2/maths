
def bisection(a, b, n,f):
    for i in range(1, n+1):
        c = (a + b) / 2    /RFM:-c=(a*f(b)-b*f(a))/(f(b)-f(a))  
        if f(a) * f(c) < 0:
            b = c
        else:
            a = c
        print(f"Iteration {i}: c = {c:.6f}, f(c) = {f(c):.6f}")
    print(f"\nApproximate root after {n} iterations: {c:.3f}")


def f(x):
    return x**3 - 2*x - 5
bisection(2, 3, 8,f)

