

def newton_raphson(x0, n,f,g):
    for i in range(1, n+1):
        x1 = x0 - f(x0) / g(x0)
        print(f"Iteration {i}: x1 = {x1:.6f}, f(x1) = {f(x1):.6f}")
        x0 = x1
    print(f"\nApproximate root after {n} iterations: {x1:.3f}")



def f(x):
    return x**3 - 2*x - 5

def g(x):
    return 3*x**2 - 2

newton_raphson(2.5, 6,f,g)
